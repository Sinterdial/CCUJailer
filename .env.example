# CCUJailer 环境变量配置示例（复制为 .env 使用，严禁提交真实密钥到仓库）

# 数据库连接地址（默认 SQLite；PostgreSQL 可改为 postgresql+asyncpg://ccujailer:changeme@127.0.0.1:5432/ccujailer）
DATABASE_URL=sqlite+aiosqlite:///./data/ccujailer.db
DATA_DIR=./data
AUTO_MIGRATE=true

# 服务监听与前端构建产物目录（留空则自动探测 frontend/dist）
HOST=0.0.0.0
PORT=8794
# FRONTEND_DIST_DIR=../frontend/dist

# 认证与访问控制配置
# 全站强制登录开关（仅支持通过环境变量配置并重启生效，Web UI 不可修改）
AUTH_REQUIRE_LOGIN=true
# 新用户注册策略：closed（关闭注册）/ invite_only（仅限邀请码）/ open（开放注册）
AUTH_REGISTRATION_MODE=closed
# 会话 JWT 签名及 TOTP 密钥加密主密钥（留空则启动时自动生成并持久化至 data/.auth_secret）
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_HOURS=168
# 可选：首次启动无用户时自动创建初始管理员（留空则打开网页时通过初始化引导页创建）
INIT_ADMIN_USERNAME=
INIT_ADMIN_PASSWORD=

# 可选：ZITADEL / 标准 OIDC PKCE 无密钥 SSO 默认配置（可在「系统设置 -> 认证与 SSO」热更新）
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=ZITADEL
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_SCOPES=openid profile email
OIDC_AUTO_REGISTER=true
OIDC_DEFAULT_ROLE=user

# 可选：静态脚本向后兼容管理访问令牌（建议留空，优先使用用户账号登录）
ADMIN_TOKEN=

# 升级路线规划功能开关（默认关闭；也可在「系统设置 -> 系统参数」中热切换）
UPGRADE_PLANNER_ENABLED=false

# 出站代理配置（支持 HTTP / HTTPS / SOCKS5，NO_PROXY 支持 CIDR 如 192.168.5.0/24）
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1
WEBHOOK_USE_PROXY=false

# 可选新船名 OpenAI 兼容翻译 API Key
TRANSLATE_API_KEY=

# 日志级别与本地文件轮转
LOG_LEVEL=INFO
LOG_TO_FILE=false
